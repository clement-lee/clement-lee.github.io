\mode<presentation>

%poster options
\newif\if@doPOSTER
\@doPOSTERfalse
\DeclareOption{poster}{\@doPOSTERtrue}
\ProcessOptions

\definecolor{lancasterRed}{RGB}{181,18,27}
\definecolor{lancasterGrey}{RGB}{129,138,143}
\definecolor{lancasterBodyGrey}{RGB}{124,122,122}
\definecolor{lancasterWhite}{RGB}{255,255,255}
\definecolor{lancasterBlack}{RGB}{35,31,32}

\definecolor{lancasterGreen1}{HTML}{17A32F}
\definecolor{lancasterGreen2}{HTML}{2B7A39}
\definecolor{lancasterGreen3}{HTML}{076A19}
\definecolor{lancasterGreen4}{HTML}{4AD162}
\definecolor{lancasterGreen5}{HTML}{6ED17F}

\definecolor{lancasterBlue1}{HTML}{147582}
\definecolor{lancasterBlue2}{HTML}{245A62}
\definecolor{lancasterBlue3}{HTML}{074B55}
\definecolor{lancasterBlue4}{HTML}{47B2C1}
\definecolor{lancasterBlue5}{HTML}{67B6C1}

\definecolor{lancasterOrange1}{HTML}{D5761E}
